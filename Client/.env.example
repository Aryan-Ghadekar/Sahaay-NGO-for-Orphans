# Base URL of the backend API (see ../Server). Leave unset during
# frontend-only development — src/api/client.js falls back to bundled
# mock data when this is empty.
VITE_API_BASE_URL=http://localhost:4000

# Set to "true" to force mock data even when VITE_API_BASE_URL is set
# (useful for demos, or working on the frontend without the server running).
# Set to "false" once the Server is running to actually hit it.
VITE_USE_MOCKS=false
