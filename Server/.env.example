# Supabase project settings — Project Settings → API in the Supabase dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Secret — never expose to the frontend or commit this. Full DB access, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the Express server listens.
PORT=4000

# Must match the frontend's dev/prod origin — used for the CORS allowlist.
CLIENT_ORIGIN=http://localhost:5173

# Used only to compute the public site's "Years of Service" stat.
ORG_FOUNDED_YEAR=2014

# Google AI Studio key (https://aistudio.google.com/apikey) — powers the
# admin's "Generate with AI" impact-narrative button. Leave blank to disable.
GEMINI_API_KEY=

# SMTP credentials for the approval-QR-code email (see
# src/services/email.service.js). Any SMTP provider works — a Gmail app
# password, Brevo/Mailtrap's free tier for testing, or a real mail server.
# Leave SMTP_HOST blank to disable — the app logs a warning and skips
# sending instead of failing the approval it's attached to.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sahaay <no-reply@sahaay.org>"
